# ---------------------------------------------------------------------------
# Supabase (required to enable the gallery, uploads and the per-project viewer)
# Project Settings -> API, in the Supabase dashboard.
# Only the public anon key goes here; never expose the service_role key.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Upload limits (optional). Values are in megabytes; defaults shown.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MAX_MODEL_MB=60
# NEXT_PUBLIC_MAX_ASSET_MB=25
# NEXT_PUBLIC_MAX_COVER_MB=8
# NEXT_PUBLIC_MAX_DEPENDENCIES=40
